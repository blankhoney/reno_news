{
  "name": "reno-news",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.1.1",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=11.0.0"
  },
  "scripts": {
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "build": "pnpm -r build",
    "db:migrate": "pnpm --filter @reno-news/db db:migrate",
    "db:seed": "pnpm --filter @reno-news/db db:seed",
    "db:backup:local": "sh scripts/db-backup.sh",
    "db:backup:offhost": "sh scripts/db-backup-offhost.sh",
    "db:restore:drill": "sh scripts/db-restore-drill.sh",
    "backup:offhost:check": "node scripts/check-offhost-backup-contract.mjs",
    "alerts:check": "node scripts/check-alert-rules.mjs",
    "ai:provider:check": "node scripts/check-ai-provider-contract.mjs",
    "ai:golden:check": "uv --project services/worker run python -m reno_worker.golden_eval --fixture services/worker/golden/ai_evaluation_golden.jsonl --provider fake",
    "github:source-policy:check": "node scripts/check-github-source-policy.mjs",
    "arxiv:source-policy:check": "node scripts/check-arxiv-source-policy.mjs",
    "source:expansion:check": "node scripts/check-source-expansion-constraints.mjs",
    "postgres:similarity:check": "node scripts/check-postgres-similarity-contract.mjs",
    "release:audit:local": "node scripts/release-health-audit.mjs",
    "disk:check:local": "node scripts/disk-usage-check.mjs",
    "compose:production:check": "node scripts/check-production-compose.mjs",
    "deploy:contract:check": "node scripts/check-deploy-contract.mjs",
    "production:gate:check": "node scripts/check-final-production-gate-review.mjs",
    "v2:plan:check": "node scripts/check-v2-plan.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
